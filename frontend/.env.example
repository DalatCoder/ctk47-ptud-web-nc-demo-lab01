# ── Culinary Blog frontend — environment contract (SPEC §4.1) ────────────────
# Sao chép thành .env.local và điền giá trị thật. `.env*` đã được gitignore.

# Base URL của .NET API. Dev: http://localhost:5000/api/v1
# Production: https://api.culinaryblog.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Origin công khai của frontend, dùng cho SEO metadata (canonical/Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret cho Auth.js v5 (sinh bằng `npx auth secret`). Bắt buộc ở production.
AUTH_SECRET=
